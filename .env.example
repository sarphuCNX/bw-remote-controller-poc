# Environment pair for the POC. bird-ai-server and cymcast MUST come from the
# same environment: the cast grant is signed by bird-ai-server and verified by
# cymcast with a per-environment shared secret, so mixing pairs fails at `connect`.
#
# production (default, as decided):
VITE_BIRDAI_SERVER_URL="https://ubs-server.birdai.com"
VITE_CYMCAST_SERVER_URL="https://cymcast.birdai.com"
#
# development pair (use when a run must not touch production data):
# VITE_BIRDAI_SERVER_URL="https://ubs-server-dev.birdai.com"
# VITE_CYMCAST_SERVER_URL="https://cymcast-dev.birdai.com"

# Not needed in v3 (token-based panel auth). Only for the legacy v1/v2 panel modes.
VITE_CYMCAST_DEVICE_SECRET=""
